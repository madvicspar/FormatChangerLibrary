@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Добро пожаловать</h2>
        <p class="auth-subtitle">Войдите в аккаунт, чтобы продолжить</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="auth-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="auth-label">Пароль</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <a id="forgot-password" asp-page="./ForgotPassword" class="auth-link">Забыли пароль?</a>
            </div>

            <button id="login-submit" type="submit" class="auth-btn mb-4">Войти</button>

            <p class="auth-footer">
                Нет аккаунта?&nbsp;<a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Зарегистрироваться</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
