@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Создать аккаунт</h2>
        <p class="auth-subtitle">Заполните данные для регистрации</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="auth-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="auth-label">Пароль</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="auth-label">Подтвердите пароль</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <label class="role">
                <input class="form-check-input" asp-for="Input.IsScoring" />
                @Html.DisplayNameFor(m => m.Input.IsScoring)
            </label>

            <button id="registerSubmit" type="submit" class="auth-btn mb-4">Зарегистрироваться</button>

            <p class="auth-footer">
                Уже есть аккаунт?&nbsp;<a asp-page="./Login" class="auth-link">Войти</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
