@model FormatChanger.Models.FormattingModels.TextSettingsModel

<div class="row">
    <div class="col-md-6">
        <label asp-for="Font" class="form-label">Шрифт</label>
        <input asp-for="Font" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="FontSize" class="form-label">Размер</label>
        <input asp-for="FontSize" type="number" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Color" class="form-label">Цвет</label>
        <input asp-for="Color" type="color" class="form-control form-control-color" />
    </div>
</div>

<div class="mt-2">
    <label class="form-label">Стиль</label><br />
    <div class="form-check form-check-inline">
        <input asp-for="IsBold" class="form-check-input" type="checkbox" />
        <label asp-for="IsBold" class="form-check-label">Жирный</label>
    </div>
    <div class="form-check form-check-inline">
        <input asp-for="IsItalic" class="form-check-input" type="checkbox" />
        <label asp-for="IsItalic" class="form-check-label">Курсив</label>
    </div>
    <div class="form-check form-check-inline">
        <input asp-for="IsUnderscore" class="form-check-input" type="checkbox" />
        <label asp-for="IsUnderscore" class="form-check-label">Подчёркнутый</label>
    </div>
</div>

<hr />

<div class="row mt-2">
    <div class="col-md-4">
        <label asp-for="LineSpacing" class="form-label">Междустрочный интервал</label>
        <input asp-for="LineSpacing" type="number" step="0.1" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="BeforeSpacing" class="form-label">Интервал до</label>
        <input asp-for="BeforeSpacing" type="number" step="0.1" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="AfterSpacing" class="form-label">Интервал после</label>
        <input asp-for="AfterSpacing" type="number" step="0.1" class="form-control" />
    </div>
</div>

<div class="row mt-2">
    <div class="col-md-4">
        <label asp-for="Justification" class="form-label">Выравнивание</label>
        <select asp-for="Justification" class="form-select">
            <option value="left">По левому краю</option>
            <option value="center">По центру</option>
            <option value="right">По правому краю</option>
            <option value="justify">По ширине</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Left" class="form-label">Отступ слева</label>
        <input asp-for="Left" type="number" step="0.1" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Right" class="form-label">Отступ справа</label>
        <input asp-for="Right" type="number" step="0.1" class="form-control" />
    </div>
</div>

<div class="row mt-2">
    <div class="col-md-4">
        <label asp-for="FirstLine" class="form-label">Отступ первой строки</label>
        <input asp-for="FirstLine" type="number" step="0.1" class="form-control" />
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check mt-3">
            <input asp-for="KeepWithNext" class="form-check-input" type="checkbox" />
            <label asp-for="KeepWithNext" class="form-check-label">Не отрывать от следующего</label>
        </div>
    </div>
</div>