@model FormatChanger.Models.FormattingModels.HeadingSettingsModel

<div class="row">
    <div class="col-md-4">
        <label asp-for="HeadingLevel" class="form-label">Уровень заголовка</label>
        <select asp-for="HeadingLevel" class="form-select">
            <option value="1">Заголовок 1 уровня</option>
            <option value="2">Заголовок 2 уровня</option>
            <option value="3">Заголовок 3 уровня</option>
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check mt-4">
            <input asp-for="StartOnNewPage" class="form-check-input" type="checkbox" />
            <label asp-for="StartOnNewPage" class="form-check-label">С новой страницы</label>
        </div>
    </div>
</div>

<hr />

<h6 class="mt-3">Настройки текста для этого уровня</h6>
<partial name="_TextSettingsForm" model="Model.TextSettings" />
