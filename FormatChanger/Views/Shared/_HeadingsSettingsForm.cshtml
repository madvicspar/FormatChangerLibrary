@model FormatChanger.Models.FormattingModels.FormattingTemplateModel

<div id="headings-editor">
    <div id="headings-list">
        @if (Model.HeadingLevelsEdit != null && Model.HeadingLevelsEdit.Any())
        {
            for (int i = 0; i < Model.HeadingLevelsEdit.Count; i++)
            {
                var level = Model.HeadingLevelsEdit[i];
                <div class="card mb-3 heading-card" data-original-index="@i">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Заголовок уровня @level.HeadingLevel</span>
                        @if (i > 0)
                        {
                            <button type="button" class="btn-close remove-heading" aria-label="Удалить"></button>
                        }
                    </div>
                    <div class="card-body">
                        <input type="hidden" class="heading-id" name="HeadingLevelsEdit[@i].Id" value="@level.Id" />
                        <input type="hidden" class="heading-level" name="HeadingLevelsEdit[@i].HeadingLevel" value="@level.HeadingLevel" />

                        <div class="form-check mb-3">
                            <input class="form-check-input start-new-page" type="checkbox" name="HeadingLevelsEdit[@i].StartOnNewPage" @(level.StartOnNewPage ? "checked" : "") />
                            <label class="form-check-label">Начинать с новой страницы</label>
                        </div>

                        <h6>Настройки текста заголовка уровня @level.HeadingLevel</h6>
                        @{
                            var prefix = $"HeadingLevelsEdit[{i}].TextSettings";
                            ViewData.TemplateInfo.HtmlFieldPrefix = prefix;
                        }
                        <partial name="_TextSettingsForm" model="level.TextSettings" />
                        @{
                            ViewData.TemplateInfo.HtmlFieldPrefix = "";
                        }
                    </div>
                </div>
            }
        }
        else
        {
            // Если нет уровней, создадим один дефолтный (чтобы пользователь видел хотя бы один)
            <div class="card mb-3 heading-card" data-original-index="0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Заголовок уровня 1</span>
                    <!-- кнопки удаления нет, так как это единственный -->
                </div>
                <div class="card-body">
                    <input type="hidden" class="heading-id" name="HeadingLevelsEdit[0].Id" value="0" />
                    <input type="hidden" class="heading-level" name="HeadingLevelsEdit[0].HeadingLevel" value="1" />

                    <div class="form-check mb-3">
                        <input class="form-check-input start-new-page" type="checkbox" name="HeadingLevelsEdit[0].StartOnNewPage" />
                        <label class="form-check-label">Начинать с новой страницы</label>
                    </div>

                    <h6>Настройки текста заголовка уровня 1</h6>
                    @{
                        var prefix = "HeadingLevelsEdit[0].TextSettings";
                        ViewData.TemplateInfo.HtmlFieldPrefix = prefix;
                    }
                    <partial name="_TextSettingsForm" model="new FormatChanger.Models.FormattingModels.TextSettingsModel()" />
                    @{
                        ViewData.TemplateInfo.HtmlFieldPrefix = "";
                    }
                </div>
            </div>
        }
    </div>

    <button type="button" id="add-heading-btn" class="btn btn-sm btn-primary">+ Добавить следующий уровень</button>
</div>