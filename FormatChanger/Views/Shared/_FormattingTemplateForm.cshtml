@model FormatChanger.Models.FormattingModels.FormattingTemplateModel

<form asp-action="SaveTemplate" method="post" id="template-save-form">
    <input type="hidden" asp-for="Id" />
    <div class="modal-header">
        <h5 class="modal-title" id="formattingTemplateModalLabel">Шаблон форматирования</h5>
    </div>

    <div class="modal-body">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#doc" type="button">Документ</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#text" type="button">Обычный текст</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#headings" type="button">Заголовки</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#lists" type="button">Списки</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tables" type="button">Таблицы</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#images" type="button">Изображения</button>
            </li>
        </ul>

        <div class="tab-content mt-3" id="tab">
            <div class="tab-pane fade show active" id="doc">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Название шаблона
                        <span class="hint-icon" data-bs-toggle="tooltip" title="Минимум 3 символа">?</span>
                    </label>
                    <input asp-for="Title" class="form-control" minlength="3" required placeholder="Название шаблона" />
                    <div class="form-text">Минимум 3 символа</div>
                </div>
                <div class="form-check mb-2">
                    <input asp-for="DocumentSettings.HasPageNumbers" class="form-check-input" />
                    <label asp-for="DocumentSettings.HasPageNumbers" class="form-check-label">Номера страниц</label>
                </div>
                <div class="form-check mb-2">
                    <input asp-for="DocumentSettings.HasTableCaptions" class="form-check-input" />
                    <label asp-for="DocumentSettings.HasTableCaptions" class="form-check-label">Подписи к таблицам</label>
                </div>
                <div class="form-check">
                    <input asp-for="DocumentSettings.HasImageCaptions" class="form-check-input" />
                    <label asp-for="DocumentSettings.HasImageCaptions" class="form-check-label">Подписи к изображениям</label>
                </div>
            </div>

            <div class="tab-pane fade" id="text">
                <div class="settings-block">
                    <div class="settings-block-header">Обычный текст</div>
                    <div class="settings-block-body">
                        @{
                            ViewData.TemplateInfo.HtmlFieldPrefix = "TextSettings";
                        }
                        <partial name="_TextSettingsForm" model="Model.TextSettings" />
                        @{
                            ViewData.TemplateInfo.HtmlFieldPrefix = "";
                        }
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="headings">
                <partial name="_HeadingsSettingsForm" model="Model" />
            </div>

            <div class="tab-pane fade" id="lists">
                @{
                    ViewData.TemplateInfo.HtmlFieldPrefix = "ListSettings";
                }
                <partial name="_ListSettingsForm" model="Model.ListSettings" />
                @{
                    ViewData.TemplateInfo.HtmlFieldPrefix = "";
                }
            </div>

            <div class="tab-pane fade" id="tables">
                @{
                    ViewData.TemplateInfo.HtmlFieldPrefix = "TableSettings";
                }
                <partial name="_TableSettingsForm" model="Model.TableSettings" />
                @{
                    ViewData.TemplateInfo.HtmlFieldPrefix = "";
                }
            </div>

            <div class="tab-pane fade" id="images">
                @{
                    ViewData.TemplateInfo.HtmlFieldPrefix = "ImageSettings";
                }
                <partial name="_ImagesForm" model="Model.ImageSettings" />
                @{
                    ViewData.TemplateInfo.HtmlFieldPrefix = "";
                }
            </div>
        </div>
    </div>

    <div class="modal-footer">
        @if (Model.Id > 0)
        {
            <button type="button" class="btn btn-outline-danger me-auto" onclick="deleteTemplateFromModal(@Model.Id)">Удалить</button>
        }
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
        <button type="submit" class="btn btn-primary">Сохранить</button>
    </div>
</form>
